{
  "name": "memvara",
  "description": "Bitemporal memory for agents: hosted MCP plus the skill that says how to use it.",
  "version": "0.3.0",
  "commands": [
    "./commands/authenticate.md",
    "./commands/index.md",
    "./commands/login.md",
    "./commands/logout.md",
    "./commands/setup.md",
    "./commands/stats.md"
  ],
  "agents": [
    "./agents/memory-researcher.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/setup.py\" install-status-line --hook",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "author": {
    "name": "Memvara",
    "url": "https://memvara.dev"
  },
  "homepage": "https://memvara.dev/docs/agents",
  "repository": "https://github.com/memvara/claude-memvara",
  "license": "Apache-2.0",
  "keywords": [
    "memory",
    "mcp",
    "agents",
    "claude-code"
  ]
}
